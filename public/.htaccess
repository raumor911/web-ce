# ========================================================= 
# CREATIVOS ESPACIOS 
# React + WordPress Headless 
# Archivo: public_html/.htaccess 
# ========================================================= 

<IfModule mod_rewrite.c> 
    RewriteEngine On 

    # ===================================================== 
    # 1. EXCLUIR WORDPRESS ANTES DE CUALQUIER OTRA REGLA 
    # ===================================================== 
    # 
    # Estas rutas no deben: 
    # - entrar al fallback de React 
    # - redirigirse por reglas internas de React 
    # - convertirse en index.html 
    # 
    # Incluye: 
    # /blog-admin/ 
    # /blog-admin/wp-admin/ 
    # /blog-admin/wp-login.php 
    # /blog-admin/wp-json/ 
    # /blog-admin/wp-content/ 
    # /blog-admin/wp-includes/ 

    RewriteCond %{REQUEST_URI} ^/blog-admin [NC] 
    RewriteRule ^ - [L] 

    # ===================================================== 
    # 1.1 REDIRECCIONES DE URLS ANTIGUAS (LEGACY)
    # ===================================================== 
    Redirect 301 /personalizar-contenedor /soluciones/venta-renta
    Redirect 301 /cotizador-renta /contacto
    Redirect 301 /productos/oficinas /soluciones/oficinas
    Redirect 301 /presentacion-empresarial /nosotros
    Redirect 301 /catalogo /soluciones/venta-renta

    # ===================================================== 
    # 2. FORZAR HTTPS Y DOMINIO SIN WWW 
    # ===================================================== 
    # 
    # Convierte: 
    # `http://creativosespacios.mx` 
    # `https://creativosespacios.mx` 
    # `https://creativosespacios.mx` 
    # 
    # En: 
    # `https://creativosespacios.mx` 

    RewriteCond %{HTTPS} !=on [OR] 
    RewriteCond %{HTTP_HOST} ^www\.creativosespacios\.mx$ [NC] 
    RewriteRule ^ https://creativosespacios.mx%{REQUEST_URI} [R=301,L,NE] 

    # ===================================================== 
    # 2.1 REMOVER /INDEX.HTML
    # ===================================================== 
    RewriteCond %{THE_REQUEST} /index\.html [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # ===================================================== 
    # 2.2 NORMALIZACIÓN DE TRAILING SLASH
    # ===================================================== 
    # Solo permite slash final en la home, remueve en rutas internas.
    # Excluye directorios físicos y WordPress
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteCond %{REQUEST_URI} !^/blog-admin [NC]
    RewriteRule ^(.+)/$ https://creativosespacios.mx/$1 [R=301,L]

    # ===================================================== 
    # 3. SERVIR ARCHIVOS PRERENDERIZADOS Y FÍSICOS 
    # ===================================================== 
    # 
    # Si pides /ruta y existe /ruta/index.html, sírvelo internamente.
    # Esto permite URLs slashless con carpetas físicas de prerender.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ $1/index.html [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR] 
    RewriteCond %{REQUEST_FILENAME} -d 
    RewriteRule ^ - [L] 

    # ===================================================== 
    # 4. FALLBACK EXCLUSIVO DE REACT ROUTER 
    # ===================================================== 
    # 
    # Solo las rutas virtuales del frontend llegan aquí. 
    # WordPress ya quedó excluido en el bloque 1. 

    RewriteRule ^ index.html [L] 
</IfModule> 

# ========================================================= 
# 4.1 ENCODING PARA ARCHIVOS SEMÁNTICOS Y DE TEXTO
# ========================================================= 

<IfModule mod_mime.c>
    AddCharset UTF-8 .txt .md .json .jsonld .xml
</IfModule>

# ========================================================= 
# 5. COMPRESIÓN GZIP 
# ========================================================= 

<IfModule mod_deflate.c> 
    AddOutputFilterByType DEFLATE text/plain 
    AddOutputFilterByType DEFLATE text/html 
    AddOutputFilterByType DEFLATE text/xml 
    AddOutputFilterByType DEFLATE text/css 
    AddOutputFilterByType DEFLATE text/javascript 

    AddOutputFilterByType DEFLATE application/javascript 
    AddOutputFilterByType DEFLATE application/x-javascript 
    AddOutputFilterByType DEFLATE application/json 
    AddOutputFilterByType DEFLATE application/xml 
    AddOutputFilterByType DEFLATE application/xhtml+xml 
    AddOutputFilterByType DEFLATE application/rss+xml 

    AddOutputFilterByType DEFLATE image/svg+xml 

    AddOutputFilterByType DEFLATE font/ttf 
    AddOutputFilterByType DEFLATE font/otf 
    AddOutputFilterByType DEFLATE font/woff 
    AddOutputFilterByType DEFLATE font/woff2 
</IfModule> 


# ========================================================= 
# 6. CACHE DE ARCHIVOS ESTÁTICOS 
# ========================================================= 

<IfModule mod_expires.c> 
    ExpiresActive On 
    ExpiresDefault "access plus 7 days" 

    # Imágenes 
    ExpiresByType image/jpg "access plus 1 year" 
    ExpiresByType image/jpeg "access plus 1 year" 
    ExpiresByType image/png "access plus 1 year" 
    ExpiresByType image/gif "access plus 1 year" 
    ExpiresByType image/webp "access plus 1 year" 
    ExpiresByType image/avif "access plus 1 year" 
    ExpiresByType image/svg+xml "access plus 1 year" 
    ExpiresByType image/x-icon "access plus 1 year" 

    # CSS y JavaScript 
    ExpiresByType text/css "access plus 1 year" 
    ExpiresByType text/javascript "access plus 1 year" 
    ExpiresByType application/javascript "access plus 1 year" 
    ExpiresByType application/x-javascript "access plus 1 year" 

    # Fuentes 
    ExpiresByType font/ttf "access plus 1 year" 
    ExpiresByType font/otf "access plus 1 year" 
    ExpiresByType font/woff "access plus 1 year" 
    ExpiresByType font/woff2 "access plus 1 year" 
    ExpiresByType application/font-woff "access plus 1 year" 
    ExpiresByType application/font-woff2 "access plus 1 year" 
</IfModule> 


# ========================================================= 
# 7. NO CACHEAR INDEX.HTML 
# ========================================================= 

<IfModule mod_headers.c> 
    <FilesMatch "\.(html)$"> 
        Header set Cache-Control "no-cache, no-store, must-revalidate" 
        Header set Pragma "no-cache" 
        Header set Expires "0" 
    </FilesMatch> 
</IfModule> 


# ========================================================= 
# 8. CORS PARA RECURSOS ESTÁTICOS 
# ========================================================= 

<IfModule mod_headers.c> 
    <FilesMatch "\.(js|css|jpg|jpeg|png|gif|webp|avif|svg|woff|woff2|ttf|otf|eot)$"> 
        Header set Access-Control-Allow-Origin "*" 
    </FilesMatch> 
</IfModule> 


# ========================================================= 
# 9. SEGURIDAD 
# ========================================================= 

<IfModule mod_headers.c> 
    Header always set X-Content-Type-Options "nosniff" 
    Header always set Referrer-Policy "strict-origin-when-cross-origin" 
    Header always set X-Frame-Options "SAMEORIGIN" 
</IfModule> 

Options -Indexes 
ServerSignature Off
