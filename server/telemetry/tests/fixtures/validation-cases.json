    { "id": "ok-page_view-attrib", "base": "page_view", "patch": { "properties.utm_source": "chatgpt.com", "properties.utm_medium": "referral", "properties.landing_source": "chatgpt.com", "properties.device_class": "mobile", "properties.previous_path": "/nosotros/" }, "expect": "ok" },
    { "id": "ok-contact_click", "base": "contact_click", "expect": "ok" },
    { "id": "ok-quote_click", "base": "quote_click", "expect": "ok" },
    { "id": "ok-navigation_click", "base": "navigation_click", "expect": "ok" },
    { "id": "ok-engagement-max", "base": "engagement", "patch": { "properties.active_ms": 30000 }, "expect": "ok" },
    { "id": "ok-blog-post-path", "base": "page_view", "patch": { "page_path": "/blog/que-son-oficinas-reubicables/" }, "expect": "ok" },
    { "id": "ok-sequence-zero", "base": "page_view", "patch": { "sequence": 0 }, "expect": "ok" },
    { "id": "extra-top-field", "base": "page_view", "patch": { "user_agent": "Mozilla/5.0" }, "expect": "unknown_field:user_agent" },
    { "id": "extra-property", "base": "contact_click", "patch": { "properties.email": "persona@example.invalid" }, "expect": "unknown_property:email" },
    { "id": "extra-property-phone", "base": "contact_click", "patch": { "properties.phone": "5555555555" }, "expect": "unknown_property:phone" },
    { "id": "missing-property", "base": "contact_click", "patch": { "properties.channel": null }, "expect": "missing_property:channel" },
    { "id": "bad-enum-channel", "base": "contact_click", "patch": { "properties.channel": "sms" }, "expect": "bad_property:channel" },
    { "id": "bad-element-unknown", "base": "contact_click", "patch": { "properties.element_id": "boton-inventado" }, "expect": "bad_property:element_id" },
    { "id": "element-wrong-event", "base": "contact_click", "patch": { "properties.element_id": "inventory-card-quote" }, "expect": "element_event_mismatch" },
    { "id": "element-wrong-placement", "base": "contact_click", "patch": { "properties.placement": "hero" }, "expect": "element_placement_mismatch" },
    { "id": "element-wrong-intent", "base": "contact_click", "patch": { "properties.intent": "quote" }, "expect": "element_intent_mismatch" },
    { "id": "bad-product-id-injection", "base": "contact_click", "patch": { "properties.product_id": "x'; DROP TABLE telemetry_events;--" }, "expect": "bad_property:product_id" },
    { "id": "bad-product-id-long", "base": "quote_click", "patch": { "properties.product_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expect": "bad_property:product_id" },
    { "id": "engagement-over-max", "base": "engagement", "patch": { "properties.active_ms": 30001 }, "expect": "bad_property:active_ms" },
    { "id": "engagement-zero", "base": "engagement", "patch": { "properties.active_ms": 0 }, "expect": "bad_property:active_ms" },
    { "id": "engagement-string", "base": "engagement", "patch": { "properties.active_ms": "500" }, "expect": "bad_property:active_ms" },
    { "id": "engagement-float", "base": "engagement", "patch": { "properties.active_ms": 10.5 }, "expect": "bad_property:active_ms" },
    { "id": "scroll-bad-percent", "base": "scroll_depth", "patch": { "properties.percent": 60 }, "expect": "bad_property:percent" },
    { "id": "form-bad-error-code", "base": "form_submit_error", "patch": { "properties.error_code": "<script>" }, "expect": "bad_property:error_code" },
    { "id": "bad-name", "base": "page_view", "patch": { "name": "heatmap_pixel" }, "expect": "bad_name" },
    { "id": "bad-event-id", "base": "page_view", "patch": { "event_id": "no-es-uuid" }, "expect": "bad_event_id" },
    { "id": "bad-session-id-uppercase", "base": "page_view", "patch": { "session_id": "22222222-2222-2222-8222-22222222222A" }, "expect": "bad_session_id" },
    { "id": "bad-sequence-negative", "base": "page_view", "patch": { "sequence": -1 }, "expect": "bad_sequence" },
    { "id": "bad-sequence-string", "base": "page_view", "patch": { "sequence": "7" }, "expect": "bad_sequence" },
    { "id": "bad-sequence-huge", "base": "page_view", "patch": { "sequence": 1000001 }, "expect": "bad_sequence" },
    { "id": "bad-timestamp", "base": "page_view", "patch": { "occurred_at": "2026-11-24 20:15:10" }, "expect": "bad_occurred_at" },
    { "id": "bad-timestamp-month", "base": "page_view", "patch": { "occurred_at": "2026-13-24T20:15:10.000Z" }, "expect": "bad_occurred_at" },
    { "id": "bad-release", "base": "page_view", "patch": { "release_id": "sha with spaces" }, "expect": "bad_release_id" },
    { "id": "path-with-query", "base": "page_view", "patch": { "page_path": "/contacto/?email=persona@example.invalid" }, "expect": "bad_page_path" },
    { "id": "path-with-fragment", "base": "page_view", "patch": { "page_path": "/contacto/#form" }, "expect": "bad_page_path" },
    { "id": "path-sensitive-admin", "base": "page_view", "patch": { "page_path": "/blog-admin/wp-login.php" }, "expect": "bad_page_path" },
    { "id": "path-sensitive-telemetria-admin", "base": "page_view", "patch": { "page_path": "/telemetria-admin/" }, "expect": "bad_page_path" },
    { "id": "path-traversal", "base": "page_view", "patch": { "page_path": "/a/../etc/passwd" }, "expect": "bad_page_path" },
    { "id": "path-encoded-slash", "base": "page_view", "patch": { "page_path": "/a%2Fb/" }, "expect": "bad_page_path" },
    { "id": "path-control-char", "base": "page_view", "patch": { "page_path": "/a\u0000b/" }, "expect": "bad_page_path" },
    { "id": "path-script", "base": "page_view", "patch": { "page_path": "/<script>alert(1)</script>/" }, "expect": "bad_page_path" },
    { "id": "path-too-long", "base": "page_view", "patch": { "page_path": "" }, "expect": "bad_page_path" },
    { "id": "path-non-canonical-no-slash", "base": "page_view", "patch": { "page_path": "/contacto" }, "expect": "bad_page_path" },
    { "id": "path-double-slash", "base": "page_view", "patch": { "page_path": "//evil.example/" }, "expect": "bad_page_path" },
    { "id": "properties-array", "base": "page_view", "patch": { "properties": [] }, "expect": "bad_properties" },
    { "id": "page-view-bad-utm-email", "base": "page_view", "patch": { "properties.utm_source": "persona@example.invalid" }, "expect": "bad_property:utm_source" },
    { "id": "page-view-bad-utm-phone", "base": "page_view", "patch": { "properties.utm_campaign": "llamar 5512345678" }, "expect": "bad_property:utm_campaign" },
    { "id": "page-view-utm-uppercase", "base": "page_view", "patch": { "properties.utm_source": "Google" }, "expect": "bad_property:utm_source" },
    { "id": "page-view-bad-host", "base": "page_view", "patch": { "properties.landing_source": "https://chatgpt.com/c/abc" }, "expect": "bad_property:landing_source" },
    { "id": "page-view-previous-path-query", "base": "page_view", "patch": { "properties.previous_path": "/x/?q=1" }, "expect": "bad_property:previous_path" }
  ],
  "path_cases": [
    { "input": "/", "expect": "/" },
    { "input": "/contacto", "expect": "/contacto/" },
    { "input": "/contacto/", "expect": "/contacto/" },
    { "input": "/contacto/?utm_source=x#y", "expect": "/contacto/" },
    { "input": "/ai/cases.json", "expect": "/ai/cases.json" },
    { "input": "/blog/mi-articulo%c3%a1/", "expect": "/blog/mi-articulo%C3%A1/" },
    { "input": "/a%2fb", "expect": null },
    { "input": "/a%00b", "expect": null },
    { "input": "/a%zz", "expect": null },
    { "input": "/a b", "expect": null },
    { "input": "a/b", "expect": null },
    { "input": "", "expect": null },
    { "input": "/./x", "expect": null },
    { "input": "/blog-admin", "expect": null },
    { "input": "/BLOG-ADMIN/x", "expect": null },
    { "input": "/telemetria/collect.php", "expect": null },
    { "input": "/formulario-creativosespacios.php", "expect": null },
    { "input": "/wp-login.php", "expect": null }
  ],
  "batch_cases": [
    { "id": "empty-events", "body": "{\"schema_version\":1,\"events\":[]}", "expect": "empty_batch" },
    { "id": "not-json", "body": "not json", "expect": "bad_json" },
    { "id": "wrong-version", "body": "{\"schema_version\":2,\"events\":[]}", "expect": "bad_envelope" },
    { "id": "extra-envelope-key", "body": "{\"schema_version\":1,\"events\":[],\"debug\":true}", "expect": "bad_envelope" },
    { "id": "events-not-array", "body": "{\"schema_version\":1,\"events\":{}}", "expect": "bad_envelope" }
  ]
}
