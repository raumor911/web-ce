{
  "$comment": "Casos compartidos: los ejecutan la prueba TypeScript (src/telemetry/tests/schema.test.ts) y la prueba PHP (server/telemetry/tests/ContractTest.php). Datos sintéticos.",
  "ids": {
    "event": "11111111-1111-4111-8111-111111111111",
    "session": "22222222-2222-2222-8222-222222222222",
    "view": "33333333-3333-3333-8333-333333333333"
  },
  "bases": {
    "page_view": { "name": "page_view", "page_path": "/", "properties": {} },
    "contact_click": { "name": "contact_click", "page_path": "/soluciones/venta-renta/", "properties": { "channel": "whatsapp", "intent": "availability", "element_id": "navbar-whatsapp-desktop", "placement": "navbar", "product_id": "product:container-20ft" } },
    "quote_click": { "name": "quote_click", "page_path": "/soluciones/venta-renta/", "properties": { "element_id": "inventory-card-quote", "placement": "inventory", "product_id": "product:container-20ft" } },
    "navigation_click": { "name": "navigation_click", "page_path": "/", "properties": { "element_id": "navbar-nav-proyectos", "destination_path": "/proyectos/", "placement": "navbar" } },
    "engagement": { "name": "engagement", "page_path": "/nosotros/", "properties": { "active_ms": 12000 } },
    "scroll_depth": { "name": "scroll_depth", "page_path": "/nosotros/", "properties": { "percent": 50 } },
    "form_submit_error": { "name": "form_submit_error", "page_path": "/contacto/", "properties": { "form_id": "contacto", "error_code": "network" } }
  },
  "event_cases": [
